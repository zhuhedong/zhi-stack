# Copy to .env. The server loads this file when started from the repository root.
DATABASE_URL=postgres://infohub:change_this_password@127.0.0.1:5432/infohub
BIND_ADDR=127.0.0.1:3210
FRONTEND_DIR=dist
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Exact hostnames or IPs for internal APIs. Empty by default; no wildcard support.
ALLOWED_PRIVATE_HOSTS=
# Optional: higher GitHub rate limits and access to repositories you can read.
GITHUB_TOKEN=
# Files are stored on the application server; PostgreSQL stores metadata only.
FILE_STORAGE=local
LOCAL_STORAGE_PATH=.local/files
# Set FILE_STORAGE=r2 to use a private Cloudflare R2 bucket instead.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Compose requires a database password. Use a unique value before starting.
POSTGRES_PASSWORD=change_this_password
# Optional: pull a pre-built image instead of compiling on the server.
# INFOHUB_IMAGE=ghcr.io/your-org/zhi-stack:latest
# VITE_API_URL=http://127.0.0.1:3210/api
