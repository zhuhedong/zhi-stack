# InfoHub configuration — the single source of truth for local runs
# (`npm run server`) and Docker Compose. Copy to .env and edit.
# The server refuses to start while a password below is still a placeholder.

############################ Required ############################

# Docker only: which deployment to run (one of: bundled | external | 1panel).
#   bundled  = PostgreSQL container + app; DATABASE_URL is generated from POSTGRES_PASSWORD
#   external = existing PostgreSQL, set DATABASE_URL below
#   1panel   = external + join 1Panel's 1panel-network (PG host = its container name)
COMPOSE_PROFILES=bundled

# bundled profile: password of the PostgreSQL container. Use URL-safe characters,
# e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change_this_password

# Local runs and external/1panel profiles: the PostgreSQL connection.
# URL-encode special characters in the password. TLS: append
#   ?sslmode=verify-full                       (public CA)
#   ?sslmode=verify-full&sslrootcert=/run/infohub/certs/pg-ca.pem   (provider CA in ./certs)
# `npm run db:dev` writes this line for you. Ignored by the bundled profile.
DATABASE_URL=postgres://infohub:change_this_password@127.0.0.1:5432/infohub

############################ Optional ############################

# Network. BIND_ADDR is for local runs (Compose fixes it to 0.0.0.0:3210 inside the container).
BIND_ADDR=127.0.0.1:3210
# Compose: host IP/port the app is published on. Use 0.0.0.0 or a LAN IP for direct LAN access.
INFOHUB_BIND_IP=127.0.0.1
INFOHUB_PORT=3210
# Public address behind a reverse proxy, e.g. https://hub.example.com — added to allowed origins.
PUBLIC_URL=
# Override the browser origin allowlist entirely (comma separated). Default is derived from
# BIND_ADDR/INFOHUB_PORT/PUBLIC_URL plus the Vite dev server and Tauri desktop origins.
ALLOWED_ORIGINS=
# Reverse proxy IPs whose X-Forwarded-For is trusted for login throttling (comma separated).
TRUSTED_PROXIES=

# First-time setup: one-time token required to create the master password (or restore into
# an empty instance). Leave empty to have a random token printed in the startup log.
SETUP_TOKEN=

# Internal hosts (exact names/IPs) that collection and API debugging may reach.
ALLOWED_PRIVATE_HOSTS=
# GitHub API token for higher rate limits / private repos. GITHUB_API_BASE for GitHub Enterprise.
GITHUB_TOKEN=
GITHUB_API_BASE=
RUST_LOG=infohub_server=info

# File storage: local disk (default) or a private Cloudflare R2 bucket.
FILE_STORAGE=local
LOCAL_STORAGE_PATH=.local/files
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only for local S3 emulators: allow an http:// R2_ENDPOINT.
R2_ALLOW_HTTP=
# Largest accepted backup upload in bytes (default 536870912 = 512 MiB).
MAX_BACKUP_BYTES=

# Docker: pull a prebuilt image instead of building locally.
# INFOHUB_IMAGE=ghcr.io/zhuhedong/zhi-stack:latest
# Directory holding pg-ca.pem for provider CAs (mounted at /run/infohub/certs).
# PG_CA_DIR=./certs
# Frontend dev only: API base for `npm run dev` against a remote server.
# VITE_API_URL=http://127.0.0.1:3210/api
