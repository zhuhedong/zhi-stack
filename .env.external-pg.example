# Copy to .env.external-pg and fill in the existing PostgreSQL connection.
# Pull a GHCR image: docker compose --env-file .env.external-pg -f compose.external-pg.yaml pull && ... up -d
# Local compile: add --build to up. See docs/deploy-docker.md.
INFOHUB_IMAGE=ghcr.io/your-org/zhi-stack:latest
# Use the database provider's hostname or a reachable remote PG address.
PGHOST=your-postgres-host.example.com
PGPORT=5432
PGUSER=infohub
PGPASSWORD='replace_with_your_existing_password'
PGDATABASE=infohub
PGSSLMODE=verify-full
# If the provider supplies a CA file, set this path and add compose.external-pg.ca.yaml.
# PG_CA_FILE=./pg-ca.pem

# Host-side HTTP binding for a reverse proxy on the application server.
# For direct LAN access, set INFOHUB_BIND_IP to the server's LAN IP or 0.0.0.0.
INFOHUB_BIND_IP=127.0.0.1
INFOHUB_PORT=3210
ALLOWED_ORIGINS=http://localhost:3210,http://127.0.0.1:3210,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# HTTP collection/probe allowlist; this does not control PostgreSQL access.
ALLOWED_PRIVATE_HOSTS=
GITHUB_TOKEN=
RUST_LOG=infohub_server=info

# Default: persistent server disk (Docker volume mounted at /data/files).
# LOCAL_STORAGE_PATH is fixed by Compose; no extra PostgreSQL instance is created.
FILE_STORAGE=local
# Optional: FILE_STORAGE=r2 and fill in all four values below.
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
