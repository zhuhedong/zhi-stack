{
  "name": "zhi-stack",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "cargo run --manifest-path server/Cargo.toml",
    "db:dev": "node scripts/dev-db.mjs",
    "test:server": "cargo test --manifest-path server/Cargo.toml",
    "test:all-integration": "node scripts/integration.mjs && node scripts/lifecycle-integration.mjs && node scripts/library-integration.mjs && node scripts/api-workspace-integration.mjs && node scripts/background-integration.mjs && node scripts/insights-integration.mjs && node scripts/feeds-integration.mjs && node scripts/highlights-integration.mjs && node scripts/imports-integration.mjs && node scripts/scheduled-backups-integration.mjs && node scripts/notifications-integration.mjs && node scripts/api-tokens-integration.mjs && node scripts/cjk-search-integration.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:lifecycle": "node scripts/lifecycle-integration.mjs",
    "test:library": "node scripts/library-integration.mjs",
    "test:api-workspace": "node scripts/api-workspace-integration.mjs",
    "test:background": "node scripts/background-integration.mjs",
    "test:insights": "node scripts/insights-integration.mjs",
    "test:feeds": "node scripts/feeds-integration.mjs",
    "test:highlights": "node scripts/highlights-integration.mjs",
    "test:imports": "node scripts/imports-integration.mjs",
    "test:docker-smoke": "node --test scripts/docker-smoke.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:request": "node --experimental-strip-types --test scripts/request.test.ts",
    "test:ui": "vitest run scripts/ui.test.tsx scripts/confirmation.test.tsx scripts/ui-controls.test.tsx scripts/functional.test.tsx scripts/features.test.tsx scripts/batch2.test.tsx scripts/batch3.test.tsx",
    "test:connection": "vitest run scripts/server-connection.test.ts scripts/server-settings.test.tsx",
    "tauri": "tauri",
    "version:bump": "node scripts/version-bump.mjs",
    "test:scheduled": "node scripts/scheduled-backups-integration.mjs",
    "test:notifications": "node scripts/notifications-integration.mjs",
    "test:api-tokens": "node scripts/api-tokens-integration.mjs",
    "test:cjk-search": "node scripts/cjk-search-integration.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
